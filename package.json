{
  "name": "@easyagent/playwright-ext",
  "version": "0.7.2",
  "description": "Playwright browser sidecar for easyagent: CDP browser automation behind one HTTP endpoint. The easybus protocol lives in the Go shell.",
  "type": "module",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "default": "./src/main.ts"
    }
  },
  "files": [
    "src",
    "manifest.yaml"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node scripts/bundle.mjs",
    "check": "biome lint .",
    "check:fix": "biome lint --write .",
    "check:types": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
