registry=https://registry.npmjs.org/
strict-ssl=false
# The SDK is published to the PUBLIC npm registry, so nothing extra is needed
# here: no scope redirect, no token.
#
# History: it used to come from GitHub Packages, which requires a token even for
# a public package (an anonymous GET returns 401). Committing a read:packages
# token to make the build self-contained backfired — GitHub's secret scanning
# detected it and REVOKED it, breaking every later install. The public registry
# has no such trap: `npm install` just works with no credentials at all.
