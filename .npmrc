registry=https://registry.npmjs.org/
strict-ssl=false
# The SDK lives on GitHub Packages, not npmjs.org. Only the SCOPE is redirected,
# so every other dependency still comes from the public registry.
@easydev-org:registry=https://npm.pkg.github.com
#
# A token is REQUIRED even though the package is public: an anonymous GET of the
# package metadata returns 401, the same request with a token returns 200
# (verified against the live registry). GitHub Packages does not serve npm
# packages anonymously.
#
# This token is committed on purpose. It carries `read:packages` and nothing
# else, so its exposure grants no more than reading a package that is already
# public — there is nothing for it to leak. It buys a build that works without
# passing a secret into every Docker/CI invocation.
//npm.pkg.github.com/:_authToken=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
